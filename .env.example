# Database
# Docker publishes this project's MySQL on a non-standard host port so it
# cannot be confused with a Homebrew/system MySQL on 3306.
MYSQL_HOST_PORT=3307
# If you change MYSQL_HOST_PORT or MYSQL_PASSWORD, update DATABASE_URL too.
DATABASE_URL=mysql+pymysql://stock_user:stock_password@127.0.0.1:3307/stock_manager

# Docker MySQL (read by docker-compose.yml; applied when the volume is first created)
MYSQL_ROOT_PASSWORD=root_password
MYSQL_PASSWORD=stock_password


# API authentication (shared household token). Required unless API_AUTH_DISABLED=true.
# Generate: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
API_TOKEN=
# Local development only: skip the token check entirely.
# API_AUTH_DISABLED=true


# FastAPI
# 127.0.0.1 = only this machine (iOS Simulator / Android Emulator work).
# Set 0.0.0.0 only when testing on a real phone over the LAN.
API_HOST=127.0.0.1
API_PORT=8000

# Browser origins allowed by CORS (comma-separated). Native apps are not affected.
# CORS_ALLOW_ORIGINS=http://localhost:8081,http://127.0.0.1:8081,http://localhost:19006


# AI features (Explore / Expand). Read once at startup: restart after changing.
# AI_RECIPE_ENABLED=false
# AI_BASE_URL=https://api.deepseek.com
# AI_API_KEY=
# AI_MODEL=deepseek-flash
# AI_TEMPERATURE=0.2
# Timeouts in seconds: per request (text / image), and per call including the retry.
# AI_TIMEOUT_SECONDS=30
# AI_IMAGE_TIMEOUT_SECONDS=60
# AI_TOTAL_TIMEOUT_SECONDS=45
# AI_IMAGE_TOTAL_TIMEOUT_SECONDS=75
# Retries after a connection error, 429 or 5xx (timeouts are not retried).
# AI_MAX_RETRIES=1
