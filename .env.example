# Database
# If you change MYSQL_PASSWORD, use the same value in DATABASE_URL.
DATABASE_URL=mysql+pymysql://stock_user:stock_password@127.0.0.1:3306/stock_manager

# Docker MySQL (read by docker-compose.yml; applied when the volume is first created)
MYSQL_ROOT_PASSWORD=root_password
MYSQL_PASSWORD=stock_password


# FastAPI
# 127.0.0.1 = only this machine (iOS Simulator / Android Emulator work).
# Set 0.0.0.0 only when testing on a real phone over the LAN.
API_HOST=127.0.0.1
API_PORT=8000

# Browser origins allowed by CORS (comma-separated). Native apps are not affected.
# CORS_ALLOW_ORIGINS=http://localhost:8081,http://127.0.0.1:8081,http://localhost:19006


# AI recipe recommendations
# AI_RECIPE_ENABLED=false
# AI_BASE_URL=https://api.deepseek.com
# AI_API_KEY=
# AI_MODEL=deepseek-chat
# AI_TIMEOUT_SECONDS=60
# AI_TEMPERATURE=0.2
